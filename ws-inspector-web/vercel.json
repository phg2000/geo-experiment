{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/inspect.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(index.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ]
}
